<?xml version="1.0" encoding="UTF-8"?>
<system>
    <!-- Define your system here -->
    <memory_region name="uart" size="0x1_000" phys_addr="0x9000000" />
    <memory_region name="client_input" size="0x1000" />
    <memory_region name="client_output" size="0x1000" />

    <protection_domain name="serialServer" priority="254">
      <program_image path="serial_server.elf"/>
      <!-- Mapping to UART -->
      <map mr="uart" vaddr="0x400000" perms="rw" cached="false" setvar_vaddr="uart_base_vaddr"/>
      <irq id="0" irq="33"/> <!-- QEMU interrupt-->
      <map mr="client_input" vaddr="0x5000000" perms="rw"/>
      <map mr="client_output" vaddr="0x5001000" perms="rw"/>
    </protection_domain>
    <protection_domain name="wordleClient" priority="0">
      <program_image path="client.elf"/>
      <map mr="client_input" vaddr="0x5000000" perms="rw"/>
      <map mr="client_output" vaddr="0x5001000" perms="rw"/>
    </protection_domain>
    <!-- channels -->
    <channel>
        <end pd="serialServer" id="1" />
        <end pd="wordleClient" id="2" />
    </channel>
</system>
